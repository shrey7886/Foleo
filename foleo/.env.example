# Copy to foleo/.env and fill in. Only GROQ_API_KEY is needed to try the app locally
# (with the demo portfolio); broker keys are only needed to link a real account.

# LLM (free key at https://console.groq.com)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Security: use long random strings in production
JWT_SECRET=change-me
BROKER_TOKEN_SECRET=change-me-too
OAUTH_STATE_HMAC_SECRET=change-me-three

# Web app origin (CORS and OAuth return address)
FRONTEND_URL=http://localhost:5174

# Brokers (optional)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=http://localhost:8000/api/zerodha/callback
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=http://localhost:8000/api/upstox/callback

# Optional: FinBERT news sentiment, password-reset email
HF_API_TOKEN=
SMTP_USERNAME=
SMTP_PASSWORD=
